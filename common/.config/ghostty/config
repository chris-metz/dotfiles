# Ghostty configuration
# Reload with Cmd+Shift+, or via the Ghostty menu (Reload Configuration).
# List available themes: ghostty +list-themes
# List available fonts:  ghostty +list-fonts

font-family = Agave Nerd Font
font-size = 18

# macOS-Schriftglaettung einschalten. Ghostty schaltet sie per Default ab,
# iTerm2 nutzt sie auf Nicht-Retina-Displays. Ohne Glaettung wirkt Agave auf
# dem externen 1080p-Monitor (1x) duenn und ausgefranst, auf dem Retina-
# Display faellt es kaum auf. Staerke 0..255 (255 = Default), 200 ist ein
# Tick leichter als der Default, ohne dass die Schrift wieder duenn wirkt.
font-thicken = true
font-thicken-strength = 200

# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# Dunkles Theme beibehalten, unabhaengig vom macOS-Erscheinungsbild.
theme = Catppuccin Mocha
window-theme = dark

# Cmd+1..9 an herdr durchreichen statt Ghostty-Tabs zu wechseln.
# esc:<n> sendet ESC gefolgt von der Ziffer, was herdr als alt+<n> liest
# (siehe switch_tab in herdr/config.toml). Ghostty-Tabs bleiben ueber
# Cmd+Shift+[ / Cmd+Shift+] und Ctrl+Tab erreichbar.
# Beide Schreibweisen, weil Ghostty die Taste als Zeichen (1) und als
# physische Taste (digit_1) per Default belegt.
keybind = super+1=esc:1
keybind = super+2=esc:2
keybind = super+3=esc:3
keybind = super+4=esc:4
keybind = super+5=esc:5
keybind = super+6=esc:6
keybind = super+7=esc:7
keybind = super+8=esc:8
keybind = super+9=esc:9
keybind = super+digit_1=esc:1
keybind = super+digit_2=esc:2
keybind = super+digit_3=esc:3
keybind = super+digit_4=esc:4
keybind = super+digit_5=esc:5
keybind = super+digit_6=esc:6
keybind = super+digit_7=esc:7
keybind = super+digit_8=esc:8
keybind = super+digit_9=esc:9

# Cmd+Shift+N / Cmd+Shift+P an herdr durchreichen (next_workspace /
# previous_workspace in herdr/config.toml). Unter Windows/Linux kommt
# Alt+Shift+N/P direkt so an.
# N: esc:N liest herdr als alt+shift+n.
# P: esc:P geht NICHT, weil ESC P im Terminal-Protokoll eine DCS-Sequenz
# einleitet und herdr dann auf deren Ende wartet. Deshalb hier die
# Kitty-Keyboard-Kodierung: CSI 112 (p) ; 4 (1 + shift 1 + alt 2) u.
keybind = super+shift+n=esc:N
keybind = super+shift+p=text:\x1b[112;4u

# Command Palette auf Cmd+Shift+K, weil Cmd+Shift+P (Ghostty-Default) oben an
# herdr durchgereicht wird.
keybind = super+shift+k=toggle_command_palette
